)

print(
    "Metrics                : SAVED"
)

print(
    "Confusion matrices     : SAVED"
)

print(
    "Representative errors  : SAVED"
)

print(
    "Checkpoint             : SAVED"
)

print()
print("=" * 70)
print("FINAL RESULTS")
print("=" * 70)

print()
print(
    "Category Accuracy      :",
    pct(
        category_metrics[
