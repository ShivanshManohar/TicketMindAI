# ============================================================
# TICKETMINDAI — PERMANENT 540 EXPERIMENT ARCHIVE
# ============================================================
#
# PURPOSE:
#   Permanently save the COMPLETE 540-ticket experiment.
#
# THIS CELL DOES NOT:
#   - load the model
#   - run inference
#   - consume GPU
#   - regenerate predictions
#
# THIS CELL DOES:
#   - read the 540 checkpoint records
#   - validate all 540 predictions exist
#   - save one complete JSON
#   - save one complete CSV
#   - save metrics
#   - save confusion matrices
#   - save representative errors
#   - create a permanent ZIP archive
#
# AFTER THIS CELL:
#   The 540 inference does NOT need to be run again.
# ============================================================

import os
import json
import shutil
import zipfile
from datetime import datetime

import pandas as pd
import numpy as np

from sklearn.metrics import (
    accuracy_score,
    precision_recall_fscore_support,
    confusion_matrix,
)

# ============================================================
# 1. PROJECT LOCATION
# ============================================================

DRIVE_ROOT = "/content/drive/MyDrive/TicketMindAI"

if os.path.isdir(DRIVE_ROOT):

    PROJECT_ROOT = DRIVE_ROOT

else:

    PROJECT_ROOT = "/content"

    print(
        "WARNING: Google Drive not detected."
    )

    print(
        "The archive will be stored in /content."
    )

# ============================================================
# 2. MAIN DIRECTORIES
# ============================================================

OUT_DIR = os.path.join(
    PROJECT_ROOT,
    "outputs",
    "ticketmind-qlora",
)

ARCHIVE_DIR = os.path.join(
    OUT_DIR,
    "FINAL_540_EXPERIMENT",
)

CONFUSION_DIR = os.path.join(
    ARCHIVE_DIR,
    "confusion_matrices",
)

os.makedirs(
    CONFUSION_DIR,
    exist_ok=True,
)

# ============================================================
# 3. SOURCE FILES
# ============================================================

CHECKPOINT_PATH = os.path.join(
    OUT_DIR,
    "FINAL_540_checkpoint.jsonl",
)

ADAPTER_DIR = os.path.join(
    OUT_DIR,
    "final_adapter",
)

BENCHMARK_CANDIDATES = [

    os.path.join(
        PROJECT_ROOT,
        "data",
        "processed",
        "benchmark.csv",
    ),

    "/content/data/processed/benchmark.csv",

]

BENCHMARK_PATH = None

for path in BENCHMARK_CANDIDATES:

    if os.path.isfile(path):

        BENCHMARK_PATH = path

        break

if BENCHMARK_PATH is None:

    raise FileNotFoundError(
        "benchmark.csv could not be found."
    )

# ============================================================
# 4. REQUIRED SOURCE VALIDATION
# ============================================================

if not os.path.isfile(
    CHECKPOINT_PATH
):

    raise FileNotFoundError(
        "540 checkpoint does not exist:\n"
        f"{CHECKPOINT_PATH}"
    )

if not os.path.isdir(
    ADAPTER_DIR
):

    raise FileNotFoundError(
        "QLoRA adapter does not exist:\n"
        f"{ADAPTER_DIR}"
    )

if not os.path.isfile(
    os.path.join(
        ADAPTER_DIR,
        "adapter_model.safetensors",
    )
):

    raise FileNotFoundError(
        "adapter_model.safetensors missing."
    )

if not os.path.isfile(
    os.path.join(
        ADAPTER_DIR,
        "adapter_config.json",
    )
):

    raise FileNotFoundError(
        "adapter_config.json missing."
    )

# ============================================================
# 5. LOAD ALL 540 CHECKPOINT RECORDS
# ============================================================

records_by_index = {}

with open(
    CHECKPOINT_PATH,
    "r",
    encoding="utf-8",
) as f:

    for line in f:

        line = line.strip()

        if not line:
            continue

        try:

            record = json.loads(
                line
            )

        except json.JSONDecodeError:

            # Ignore a possible truncated final line.
            continue

        if not isinstance(
            record,
            dict,
        ):

            continue

        if (
            "benchmark_index"
            not in record
        ):

            continue

        idx = int(
            record[
                "benchmark_index"
            ]
        )

        if 0 <= idx < 540:

            records_by_index[idx] = (
                record
            )

# ============================================================
# 6. HARD 540/540 VALIDATION
# ============================================================

expected_indices = set(
    range(540)
)

actual_indices = set(
    records_by_index.keys()
)

missing_indices = sorted(
    expected_indices
    -
    actual_indices
)

extra_indices = sorted(
    actual_indices
    -
    expected_indices
)

print()
print("=" * 70)
print("540 CHECKPOINT VALIDATION")
print("=" * 70)

print(
    "Expected records :",
    540,
)

print(
    "Found records    :",
    len(records_by_index),
)

print(
    "Missing records  :",
    len(missing_indices),
)

print(
    "Extra records    :",
    len(extra_indices),
)

if missing_indices:

    raise RuntimeError(
        "STOP.\n"
        "The 540 benchmark is incomplete.\n\n"
        f"Missing indices:\n{missing_indices}"
    )

if extra_indices:

    raise RuntimeError(
        "Unexpected benchmark indices:\n"
        f"{extra_indices}"
    )

assert len(
    records_by_index
) == 540

print(
    "✓ ALL 540 PREDICTIONS EXIST"
)

# ============================================================
# 7. SORT IN ORIGINAL BENCHMARK ORDER
# ============================================================

records = [

    records_by_index[i]

    for i in range(540)

]

results = pd.DataFrame(
    records
)

assert len(results) == 540

# ============================================================
# 8. LOAD ORIGINAL BENCHMARK
# ============================================================

benchmark_df = pd.read_csv(
    BENCHMARK_PATH
).reset_index(drop=True)

if len(
    benchmark_df
) != 540:

    raise RuntimeError(
        "Benchmark must contain exactly "
        f"540 rows. Found {len(benchmark_df)}."
    )

# ============================================================
# 9. VERIFY BENCHMARK ORDER
# ============================================================

for i in range(540):

    checkpoint_input = str(
        records[i]["input"]
    ).strip()

    benchmark_input = str(
        benchmark_df.iloc[i]["input"]
    ).strip()

    if checkpoint_input != (
        benchmark_input
    ):

        raise RuntimeError(
            "BENCHMARK ORDER MISMATCH.\n"
            f"Index: {i}\n"
            f"Checkpoint: {checkpoint_input}\n"
            f"Benchmark: {benchmark_input}"
        )

print(
    "✓ Benchmark order verified"
)

# ============================================================
# 10. CREATE COMPLETE 540 DATASET
# ============================================================
#
# This is the most important file.
#
# Every row contains:
#
# INPUT
# TRUE LABELS
# RAW MODEL OUTPUT
# PARSED PREDICTIONS
# VALIDITY FLAGS
#
# ============================================================

complete_540 = []

for record in records:

    complete_540.append({

        "benchmark_index":
            record[
                "benchmark_index"
            ],

        "input":
            record["input"],

        "true_category":
            record[
                "true_category"
            ],

        "pred_category":
            record[
                "pred_category"
            ],

        "true_subcategory":
            record[
                "true_subcategory"
            ],

        "pred_subcategory":
            record[
                "pred_subcategory"
            ],

        "true_priority":
            record[
                "true_priority"
            ],

        "pred_priority_raw":
            record[
                "pred_priority_raw"
            ],

        "pred_priority_norm":
            record[
                "pred_priority_norm"
            ],

        "priority_valid":
            record[
                "priority_valid"
            ],

        "pred_sentiment":
            record[
                "pred_sentiment"
            ],

        "pred_summary":
            record[
                "pred_summary"
            ],

        "valid_json":
            record[
                "valid_json"
            ],

        "malformed":
            record[
                "malformed"
            ],

        "raw_model_output":
            record[
                "raw_model_output"
            ],
    })

complete_df = pd.DataFrame(
    complete_540
)

assert len(
    complete_df
) == 540

# ============================================================
# 11. SAVE COMPLETE JSON
# ============================================================

COMPLETE_JSON = os.path.join(
    ARCHIVE_DIR,
    "FINAL_540_COMPLETE.json",
)

with open(
    COMPLETE_JSON,
    "w",
    encoding="utf-8",
) as f:

    json.dump(
        complete_540,
        f,
        indent=2,
        ensure_ascii=False,
    )

print(
    "✓ Complete JSON saved"
)

# ============================================================
# 12. SAVE COMPLETE CSV
# ============================================================

COMPLETE_CSV = os.path.join(
    ARCHIVE_DIR,
    "FINAL_540_COMPLETE.csv",
)

complete_df.to_csv(
    COMPLETE_CSV,
    index=False,
    encoding="utf-8-sig",
)

print(
    "✓ Complete CSV saved"
)

# ============================================================
# 13. METRICS
# ============================================================

category_labels = sorted(
    complete_df[
        "true_category"
    ].unique()
)

subcategory_labels = sorted(
    complete_df[
        "true_subcategory"
    ].unique()
)

priority_labels = [
    "HIGH",
    "MEDIUM",
    "LOW",
]

def calculate_metrics(
    true,
    pred,
    labels,
):

    accuracy = accuracy_score(
        true,
        pred,
    )

    precision, recall, f1, _ = (
        precision_recall_fscore_support(
            true,
            pred,
            labels=labels,
            average="macro",
            zero_division=0,
        )
    )

    return {

        "accuracy":
            float(accuracy),

        "macro_precision":
            float(precision),

        "macro_recall":
            float(recall),

        "macro_f1":
            float(f1),
    }

# ============================================================
# 14. CATEGORY METRICS
# ============================================================

category_metrics = calculate_metrics(

    complete_df[
        "true_category"
    ],

    complete_df[
        "pred_category"
    ],

    category_labels,
)

# ============================================================
# 15. SUBCATEGORY METRICS
# ============================================================

subcategory_metrics = calculate_metrics(

    complete_df[
        "true_subcategory"
    ],

    complete_df[
        "pred_subcategory"
    ],

    subcategory_labels,
)

# ============================================================
# 16. PRIORITY METRICS
# ============================================================

priority_metrics = calculate_metrics(

    complete_df[
        "true_priority"
    ],

    complete_df[
        "pred_priority_norm"
    ],

    priority_labels,
)

# ============================================================
# 17. JSON QUALITY
# ============================================================

valid_json_rate = float(
    complete_df[
        "valid_json"
    ].mean()
)

malformed_count = int(
    complete_df[
        "malformed"
    ].sum()
)

invalid_priority_count = int(
    (
        ~complete_df[
            "priority_valid"
        ]
    ).sum()
)

# ============================================================
# 18. EXACT STRUCTURED MATCH
# ============================================================

exact_match = (

    (
        complete_df[
            "true_category"
        ]
        ==
        complete_df[
            "pred_category"
        ]
    )

    &

    (
        complete_df[
            "true_subcategory"
        ]
        ==
        complete_df[
            "pred_subcategory"
        ]
    )

    &

    (
        complete_df[
            "true_priority"
        ]
        ==
        complete_df[
            "pred_priority_norm"
        ]
    )
)

exact_match_rate = float(
    exact_match.mean()
)

# ============================================================
# 19. PROMPT BASELINE
# ============================================================

BASELINE = {

    "category": {

        "accuracy":
            0.9741,

        "macro_precision":
            0.9762,

        "macro_recall":
            0.9708,

        "macro_f1":
            0.9716,
    },

    "subcategory": {

        "accuracy":
            0.9481,

        "macro_precision":
            0.9537,

        "macro_recall":
            0.9481,

        "macro_f1":
            0.9480,
    },

    "priority": {

        "accuracy":
            0.3870,

        "macro_precision":
            0.2176,

        "macro_recall":
            0.3653,

        "macro_f1":
            0.2711,
    },
}

# ============================================================
# 20. BASELINE COMPARISON
# ============================================================

comparison = {

    "category": {

        "accuracy_delta":
            category_metrics[
                "accuracy"
            ]
            -
            BASELINE[
                "category"
            ][
                "accuracy"
            ],

        "macro_f1_delta":
            category_metrics[
                "macro_f1"
            ]
            -
            BASELINE[
                "category"
            ][
                "macro_f1"
            ],
    },

    "subcategory": {

        "accuracy_delta":
            subcategory_metrics[
                "accuracy"
            ]
            -
            BASELINE[
                "subcategory"
            ][
                "accuracy"
            ],

        "macro_f1_delta":
            subcategory_metrics[
                "macro_f1"
            ]
            -
            BASELINE[
                "subcategory"
            ][
                "macro_f1"
            ],
    },

    "priority": {

        "accuracy_delta":
            priority_metrics[
                "accuracy"
            ]
            -
            BASELINE[
                "priority"
            ][
                "accuracy"
            ],

        "macro_f1_delta":
            priority_metrics[
                "macro_f1"
            ]
            -
            BASELINE[
                "priority"
            ][
                "macro_f1"
            ],
    },
}

# ============================================================
# 21. CONFUSION MATRICES
# ============================================================

category_cm = confusion_matrix(

    complete_df[
        "true_category"
    ],

    complete_df[
        "pred_category"
    ],

    labels=category_labels,
)

pd.DataFrame(

    category_cm,

    index=category_labels,

    columns=category_labels,

).to_csv(

    os.path.join(
        CONFUSION_DIR,
        "category_confusion.csv",
    )
)

subcategory_cm = confusion_matrix(

    complete_df[
        "true_subcategory"
    ],

    complete_df[
        "pred_subcategory"
    ],

    labels=subcategory_labels,
)

pd.DataFrame(

    subcategory_cm,

    index=subcategory_labels,

    columns=subcategory_labels,

).to_csv(

    os.path.join(
        CONFUSION_DIR,
        "subcategory_confusion.csv",
    )
)

priority_cm_labels = [

    "HIGH",
    "MEDIUM",
    "LOW",
    "INVALID",
]

priority_cm = confusion_matrix(

    complete_df[
        "true_priority"
    ],

    complete_df[
        "pred_priority_norm"
    ],

    labels=priority_cm_labels,
)

pd.DataFrame(

    priority_cm,

    index=priority_cm_labels,

    columns=priority_cm_labels,

).to_csv(

    os.path.join(
        CONFUSION_DIR,
        "priority_confusion.csv",
    )
)

# ============================================================
# 22. REPRESENTATIVE ERRORS
# ============================================================

errors = complete_df[
    ~exact_match
].copy()

if len(errors) > 15:

    representative_errors = (
        errors.sample(
            n=15,
            random_state=42,
        )
    )

else:

    representative_errors = (
        errors
    )

ERRORS_CSV = os.path.join(
    ARCHIVE_DIR,
    "FINAL_540_REPRESENTATIVE_ERRORS.csv",
)

representative_errors.to_csv(
    ERRORS_CSV,
    index=False,
)

# ============================================================
# 23. DISTRIBUTIONS
# ============================================================

distributions = {

    "true_category":
        complete_df[
            "true_category"
        ]
        .value_counts()
        .to_dict(),

    "pred_category":
        complete_df[
            "pred_category"
        ]
        .value_counts()
        .to_dict(),

    "true_subcategory":
        complete_df[
            "true_subcategory"
        ]
        .value_counts()
        .to_dict(),

    "pred_subcategory":
        complete_df[
            "pred_subcategory"
        ]
        .value_counts()
        .to_dict(),

    "true_priority":
        complete_df[
            "true_priority"
        ]
        .value_counts()
        .to_dict(),

    "pred_priority_raw":
        complete_df[
            "pred_priority_raw"
        ]
        .value_counts()
        .to_dict(),

    "pred_priority_norm":
        complete_df[
            "pred_priority_norm"
        ]
        .value_counts()
        .to_dict(),
}

# ============================================================
# 24. METRICS JSON
# ============================================================

final_metrics = {

    "experiment":
        "TicketMindAI FINAL QLoRA 540 Benchmark",

    "n_samples":
        540,

    "benchmark_file":
        BENCHMARK_PATH,

    "adapter_directory":
        ADAPTER_DIR,

    "valid_json_rate":
        valid_json_rate,

    "malformed_predictions":
        malformed_count,

    "invalid_priority_predictions":
        invalid_priority_count,

    "exact_structured_match_rate":
        exact_match_rate,

    "category":
        category_metrics,

    "subcategory":
        subcategory_metrics,

    "priority":
        priority_metrics,

    "baseline":
        BASELINE,

    "baseline_comparison":
        comparison,

    "distributions":
        distributions,
}

METRICS_JSON = os.path.join(
    ARCHIVE_DIR,
    "FINAL_540_METRICS.json",
)

with open(
    METRICS_JSON,
    "w",
    encoding="utf-8",
) as f:

    json.dump(
        final_metrics,
        f,
        indent=2,
        ensure_ascii=False,
    )

# ============================================================
# 25. COPY ORIGINAL BENCHMARK
# ============================================================

ARCHIVED_BENCHMARK = os.path.join(
    ARCHIVE_DIR,
    "benchmark_540_original.csv",
)

shutil.copy2(
    BENCHMARK_PATH,
    ARCHIVED_BENCHMARK,
)

print(
    "✓ Original benchmark archived"
)

# ============================================================
# 26. COPY CHECKPOINT
# ============================================================

ARCHIVED_CHECKPOINT = os.path.join(
    ARCHIVE_DIR,
    "FINAL_540_checkpoint.jsonl",
)

shutil.copy2(
    CHECKPOINT_PATH,
    ARCHIVED_CHECKPOINT,
)

print(
    "✓ Checkpoint archived"
)

# ============================================================
# 27. COPY QLORA ADAPTER
# ============================================================

ARCHIVED_ADAPTER = os.path.join(
    ARCHIVE_DIR,
    "final_adapter",
)

if os.path.exists(
    ARCHIVED_ADAPTER
):

    shutil.rmtree(
        ARCHIVED_ADAPTER
    )

shutil.copytree(
    ADAPTER_DIR,
    ARCHIVED_ADAPTER,
)

print(
    "✓ Trained QLoRA adapter archived"
)

# ============================================================
# 28. CREATE MANIFEST
# ============================================================

manifest = {

    "project":
        "TicketMindAI",

    "experiment":
        "FINAL QLoRA 540 benchmark",

    "created_at":
        datetime.now().isoformat(),

    "samples":
        540,

    "benchmark":
        "benchmark_540_original.csv",

    "trained_adapter":
        "final_adapter/",

    "complete_predictions":
        "FINAL_540_COMPLETE.json",

    "complete_predictions_csv":
        "FINAL_540_COMPLETE.csv",

    "metrics":
        "FINAL_540_METRICS.json",

    "representative_errors":
        "FINAL_540_REPRESENTATIVE_ERRORS.csv",

    "checkpoint":
        "FINAL_540_checkpoint.jsonl",

    "confusion_matrices":
        "confusion_matrices/",

    "inference_required_after_archive":
        False,

    "benchmark_rerun_required":
        False,

    "training_rerun_required":
        False,

    "notes": [
        "540 benchmark predictions are permanently archived.",
        "Raw model outputs are preserved.",
        "Ground-truth labels are preserved.",
        "Parsed predictions are preserved.",
        "QLoRA adapter is preserved.",
        "Evaluation metrics are preserved.",
        "Confusion matrices are preserved.",
        "The archive is sufficient to reproduce the reported evaluation analysis without rerunning model inference."
    ],
}

MANIFEST_PATH = os.path.join(
    ARCHIVE_DIR,
    "MANIFEST.json",
)

with open(
    MANIFEST_PATH,
    "w",
    encoding="utf-8",
) as f:

    json.dump(
        manifest,
        f,
        indent=2,
        ensure_ascii=False,
    )

print(
    "✓ Manifest created"
)

# ============================================================
# 29. CREATE PERMANENT ZIP
# ============================================================
#
# This gives you ONE portable file.
#
# It contains:
#   - trained adapter
#   - all 540 predictions
#   - original benchmark
#   - metrics
#   - checkpoint
#   - confusion matrices
#   - errors
#   - manifest
#
# ============================================================

ZIP_PATH = os.path.join(
    OUT_DIR,
    "TicketMindAI_FINAL_540_EXPERIMENT.zip",
)

if os.path.isfile(
    ZIP_PATH
):

    os.remove(
        ZIP_PATH
    )

with zipfile.ZipFile(
    ZIP_PATH,
    "w",
    compression=zipfile.ZIP_DEFLATED,
) as zipf:

    for root, dirs, files in os.walk(
        ARCHIVE_DIR
    ):

        for filename in files:

            full_path = os.path.join(
                root,
                filename,
            )

            relative_path = os.path.relpath(
                full_path,
                ARCHIVE_DIR,
            )

            zipf.write(
                full_path,
                arcname=relative_path,
            )

# ============================================================
# 30. VERIFY ZIP
# ============================================================

with zipfile.ZipFile(
    ZIP_PATH,
    "r",
) as zipf:

    bad_file = zipf.testzip()

    if bad_file is not None:

        raise RuntimeError(
            "ZIP verification failed: "
            f"{bad_file}"
        )

print(
    "✓ ZIP archive verified"
)

# ============================================================
# 31. FINAL REPORT
# ============================================================

